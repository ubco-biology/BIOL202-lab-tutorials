# Quarto working files
.quarto/
/.quarto/
**/*.quarto_ipynb
_book/

# Knitr/rmarkdown intermediates left beside the .qmd source
/*_files/
/*_cache/

# R session leftovers
.Rproj.user
.Rhistory
.RData
.DS_Store

# NOTE: docs/ is the rendered website and IS committed — GitHub Pages serves it
# from this branch. The ignore rules above are anchored with a leading "/" so
# they match only the project root; without that anchoring they would also match
# docs/*_files/, which holds every figure on the published site.
!docs/
